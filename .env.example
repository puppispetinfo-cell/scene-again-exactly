# This file documents names only. Local values belong in .env.local (ignored).
VITE_CONTENT_PROVIDER=mock
# Use supabase for staging/production. Production refuses mock data.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:4173
SITE_ORIGIN=https://www.rivton.example
SITE_ENVIRONMENT=staging
ADMIN_REQUIRE_MFA=false
# No service-role key is needed for normal application requests.

# At least 32 random characters, server-only.
PREVIEW_SECRET=
